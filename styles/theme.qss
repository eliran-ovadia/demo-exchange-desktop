/* ============================================================
   Demo Exchange — Light Professional Theme
   Design language: Robinhood / Fidelity fintech style
   ============================================================ */

/* ── Global reset ─────────────────────────────────────────── */
QWidget {
    background-color: #f5f7fa;
    color: #1a1a2e;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

QMainWindow, QDialog {
    background-color: #f5f7fa;
}

/* ── Base button fallback (catches any button without objectName) */
QPushButton {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 500;
    min-height: 40px;
}
QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}
QPushButton:pressed {
    background-color: #e2e8f0;
}
QPushButton:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QPushButton:focus {
    outline: none;
}

/* ── Card / panel surfaces ────────────────────────────────── */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#cardFlat {
    background-color: #ffffff;
    border: none;
    border-radius: 10px;
}

/* ── Typography helpers ───────────────────────────────────── */
QLabel#heading1 {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a2e;
    background: transparent;
}

QLabel#heading2 {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a2e;
    background: transparent;
}

QLabel#heading3 {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a2e;
    background: transparent;
}

QLabel#subtext {
    font-size: 13px;
    color: #64748b;
    background: transparent;
}

QLabel#mono {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    color: #1a1a2e;
    background: transparent;
}

QLabel#priceUp {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #16a34a;
    background: transparent;
}

QLabel#priceDown {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #dc2626;
    background: transparent;
}

QLabel#priceNeutral {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    background: transparent;
}

QLabel#bigValue {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 32px;
    font-weight: 700;
    color: #1a1a2e;
    background: transparent;
}

QLabel#errorLabel {
    font-size: 13px;
    color: #dc2626;
    background: transparent;
}

QLabel#successLabel {
    font-size: 13px;
    color: #16a34a;
    background: transparent;
}

/* ── Primary button ───────────────────────────────────────── */
QPushButton#btnPrimary {
    background-color: #1e3a8a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btnPrimary:hover {
    background-color: #1e40af;
}
QPushButton#btnPrimary:pressed {
    background-color: #1e3a8a;
}
QPushButton#btnPrimary:disabled {
    background-color: #94a3b8;
    color: #e2e8f0;
    border: none;
}

/* ── Secondary button ─────────────────────────────────────── */
QPushButton#btnSecondary {
    background-color: #ffffff;
    color: #1e3a8a;
    border: 1.5px solid #1e3a8a;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btnSecondary:hover {
    background-color: #eff6ff;
}
QPushButton#btnSecondary:pressed {
    background-color: #dbeafe;
}
QPushButton#btnSecondary:disabled {
    border-color: #cbd5e1;
    color: #94a3b8;
    background-color: #f8fafc;
}

/* ── Buy / Sell action buttons ────────────────────────────── */
QPushButton#btnBuy {
    background-color: #16a34a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btnBuy:hover {
    background-color: #15803d;
}
QPushButton#btnBuy:pressed {
    background-color: #166534;
}
QPushButton#btnBuy:disabled {
    background-color: #86efac;
    color: #ffffff;
    border: none;
}

QPushButton#btnSell {
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btnSell:hover {
    background-color: #b91c1c;
}
QPushButton#btnSell:pressed {
    background-color: #991b1b;
}
QPushButton#btnSell:disabled {
    background-color: #fca5a5;
    color: #ffffff;
    border: none;
}

/* ── Danger / ghost buttons ───────────────────────────────── */
QPushButton#btnDanger {
    background-color: transparent;
    color: #dc2626;
    border: 1.5px solid #dc2626;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}
QPushButton#btnDanger:hover {
    background-color: #fef2f2;
}
QPushButton#btnDanger:pressed {
    background-color: #fee2e2;
}
QPushButton#btnDanger:disabled {
    color: #fca5a5;
    border-color: #fca5a5;
    background-color: transparent;
}

QPushButton#btnGhost {
    background: none;
    border: none;
    color: #1e3a8a;
    font-size: 13px;
    font-weight: 600;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
    max-height: 20px;
    min-width: 0px;
}
QPushButton#btnGhost:hover {
    color: #2563eb;
    background: none;
    border: none;
}
QPushButton#btnGhost:pressed {
    color: #1e3a8a;
    background: none;
    border: none;
}

/* ── Line inputs ──────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 38px;
    selection-background-color: #bfdbfe;
}
QLineEdit:focus {
    border-color: #1e3a8a;
    background-color: #ffffff;
}
QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QLineEdit[echoMode="2"] {
    lineedit-password-character: 9679;
}
QLineEdit::placeholder {
    color: #94a3b8;
}

/* ── Spin box ─────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 38px;
    font-size: 14px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1e3a8a;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    border-top-right-radius: 6px;
    background: #f8fafc;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #e2e8f0;
    border-top: 1px solid #e2e8f0;
    border-bottom-right-radius: 6px;
    background: #f8fafc;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #e2e8f0;
}

/* ── Combo box ────────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 38px;
    font-size: 14px;
}
QComboBox:focus {
    border-color: #1e3a8a;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    selection-background-color: #eff6ff;
    selection-color: #1e3a8a;
    outline: none;
}

/* ── Table ────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #eff6ff;
    selection-color: #1e3a8a;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 8px 12px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #eff6ff;
    color: #1e3a8a;
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: #f8fafc;
}
QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    text-transform: uppercase;
}
QHeaderView::section:first {
    border-top-left-radius: 10px;
}
QHeaderView::section:last {
    border-top-right-radius: 10px;
}
QHeaderView::section:hover {
    background-color: #f1f5f9;
    color: #475569;
}

/* ── Scrollbars ───────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Sidebar navigation ───────────────────────────────────── */
QFrame#sidebar {
    background-color: #1a1a2e;
    border: none;
    border-right: 1px solid #252540;
    min-width: 210px;
    max-width: 210px;
}

/* All widgets inside the sidebar inherit the dark background */
QFrame#sidebar QWidget {
    background-color: transparent;
    color: #94a3b8;
}
QFrame#sidebar QLabel {
    background-color: transparent;
}

QPushButton#navItem {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 500;
    min-height: 42px;
}
QPushButton#navItem:hover {
    background-color: #252540;
    color: #e2e8f0;
}
QPushButton#navItem:pressed {
    background-color: #2a2a4e;
    color: #ffffff;
}

QPushButton#navItemActive {
    background-color: #1e40af;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 600;
    min-height: 42px;
}
QPushButton#navItemActive:hover {
    background-color: #2563eb;
    color: #ffffff;
}
QPushButton#navItemActive:pressed {
    background-color: #1d4ed8;
    color: #ffffff;
}

QLabel#sidebarLogo {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 4px 14px 4px 14px;
    background: transparent;
    letter-spacing: 0.3px;
}

QLabel#sidebarUser {
    color: #64748b;
    font-size: 12px;
    padding: 4px 14px;
    background: transparent;
}

/* ── Status badges ────────────────────────────────────────── */
QLabel#badgeOpen {
    background-color: #dcfce7;
    color: #166534;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#badgeClosed {
    background-color: #fee2e2;
    color: #991b1b;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#badgeNeutral {
    background-color: #f1f5f9;
    color: #475569;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* ── Progress / loading bar ───────────────────────────────── */
QProgressBar {
    background-color: #e2e8f0;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    font-size: 0px;
}
QProgressBar::chunk {
    background-color: #1e3a8a;
    border-radius: 4px;
}

/* ── Tool tips ────────────────────────────────────────────── */
QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Separator ────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #e2e8f0;
    background-color: #e2e8f0;
    border: none;
    max-height: 1px;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #e2e8f0;
    width: 1px;
    height: 1px;
}

/* ── Login / Register screens ─────────────────────────────── */
QFrame#loginCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 8px;
}

QLabel#loginLogo {
    font-size: 26px;
    font-weight: 800;
    color: #1e3a8a;
    background: transparent;
    letter-spacing: -0.5px;
}

QLabel#loginTagline {
    font-size: 14px;
    color: #64748b;
    background: transparent;
}

/* ── Stat cards ───────────────────────────────────────────── */
QFrame#statCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QLabel#statLabel {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.8px;
    background: transparent;
}

QLabel#statValue {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 22px;
    font-weight: 700;
    color: #1a1a2e;
    background: transparent;
}
