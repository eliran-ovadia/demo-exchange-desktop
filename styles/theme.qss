/* ============================================================
   Demo Exchange — Light Professional Theme
   Design language: Robinhood / Fidelity fintech style
   All dimensions in px; font stack leans on system sans-serif.
   ============================================================ */

/* ── Global reset ─────────────────────────────────────────── */
QWidget {
    background-color: #f5f7fa;
    color: #1a1a2e;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #f5f7fa;
}

/* ── Card / panel surfaces ────────────────────────────────── */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#cardFlat {
    background-color: #ffffff;
    border: none;
    border-radius: 10px;
}

/* ── Typography helpers (set via objectName) ──────────────── */
QLabel#heading1 {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a2e;
}

QLabel#heading2 {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a2e;
}

QLabel#heading3 {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a2e;
}

QLabel#subtext {
    font-size: 13px;
    color: #64748b;
}

QLabel#mono {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", "Courier New", monospace;
    font-size: 14px;
    color: #1a1a2e;
}

QLabel#priceUp {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #16a34a;
}

QLabel#priceDown {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #dc2626;
}

QLabel#priceNeutral {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
}

QLabel#bigValue {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 32px;
    font-weight: 700;
    color: #1a1a2e;
}

QLabel#errorLabel {
    font-size: 13px;
    color: #dc2626;
    background: transparent;
}

QLabel#successLabel {
    font-size: 13px;
    color: #16a34a;
    background: transparent;
}

/* ── Primary button ───────────────────────────────────────── */
QPushButton#btnPrimary {
    background-color: #1e3a8a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btnPrimary:hover {
    background-color: #1e40af;
}
QPushButton#btnPrimary:pressed {
    background-color: #1e3a8a;
    padding-top: 12px;
    padding-bottom: 8px;
}
QPushButton#btnPrimary:disabled {
    background-color: #94a3b8;
    color: #e2e8f0;
}

/* ── Secondary button ─────────────────────────────────────── */
QPushButton#btnSecondary {
    background-color: #ffffff;
    color: #1e3a8a;
    border: 1.5px solid #1e3a8a;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#btnSecondary:hover {
    background-color: #eff6ff;
}
QPushButton#btnSecondary:pressed {
    background-color: #dbeafe;
}
QPushButton#btnSecondary:disabled {
    border-color: #cbd5e1;
    color: #94a3b8;
}

/* ── Buy / Sell action buttons ────────────────────────────── */
QPushButton#btnBuy {
    background-color: #16a34a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btnBuy:hover {
    background-color: #15803d;
}
QPushButton#btnBuy:pressed {
    background-color: #166534;
}

QPushButton#btnSell {
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btnSell:hover {
    background-color: #b91c1c;
}
QPushButton#btnSell:pressed {
    background-color: #991b1b;
}

/* ── Danger / ghost buttons ───────────────────────────────── */
QPushButton#btnDanger {
    background-color: transparent;
    color: #dc2626;
    border: 1.5px solid #dc2626;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}
QPushButton#btnDanger:hover {
    background-color: #fef2f2;
}

QPushButton#btnGhost {
    background-color: transparent;
    color: #475569;
    border: none;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#btnGhost:hover {
    color: #1e3a8a;
    background-color: #eff6ff;
    border-radius: 6px;
}

/* ── Icon-only toolbar button ─────────────────────────────── */
QPushButton#btnIcon {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}
QPushButton#btnIcon:hover {
    background-color: #e2e8f0;
}

/* ── Line inputs ──────────────────────────────────────────── */
QLineEdit {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 38px;
    selection-background-color: #bfdbfe;
}
QLineEdit:focus {
    border-color: #1e3a8a;
    background-color: #ffffff;
}
QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QLineEdit[echoMode="2"] {
    lineedit-password-character: 9679;
}

/* ── Spin box ─────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 38px;
    font-size: 14px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1e3a8a;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    border-top-right-radius: 6px;
    background: #f8fafc;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #e2e8f0;
    border-top: 1px solid #e2e8f0;
    border-bottom-right-radius: 6px;
    background: #f8fafc;
}

/* ── Combo box ────────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 38px;
    font-size: 14px;
}
QComboBox:focus {
    border-color: #1e3a8a;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    selection-background-color: #eff6ff;
    selection-color: #1e3a8a;
    outline: none;
}

/* ── Table ────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    gridline-color: #e2e8f0;
    selection-background-color: #eff6ff;
    selection-color: #1e3a8a;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 8px 12px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #eff6ff;
    color: #1e3a8a;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 8px 12px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
}
QHeaderView::section:first {
    border-top-left-radius: 10px;
}
QHeaderView::section:last {
    border-top-right-radius: 10px;
}

/* ── Scrollbars ───────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f1f5f9;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #f1f5f9;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Tab widget ───────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background-color: #ffffff;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #64748b;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}
QTabBar::tab:selected {
    color: #1e3a8a;
    border-bottom: 2px solid #1e3a8a;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #334155;
    border-bottom: 2px solid #cbd5e1;
}

/* ── Sidebar navigation ───────────────────────────────────── */
QFrame#sidebar {
    background-color: #1a1a2e;
    border: none;
    min-width: 200px;
    max-width: 200px;
}

QPushButton#navItem {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 42px;
}
QPushButton#navItem:hover {
    background-color: #ffffff18;
    color: #e2e8f0;
}
QPushButton#navItemActive {
    background-color: #1e40af;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    min-height: 42px;
}

QLabel#sidebarLogo {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding: 8px 16px;
    background: transparent;
}

QLabel#sidebarUser {
    color: #94a3b8;
    font-size: 12px;
    padding: 4px 16px;
    background: transparent;
}

/* ── Status badge ─────────────────────────────────────────── */
QLabel#badgeOpen {
    background-color: #dcfce7;
    color: #166534;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#badgeClosed {
    background-color: #fee2e2;
    color: #991b1b;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#badgeNeutral {
    background-color: #f1f5f9;
    color: #475569;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* ── Progress / loading bar ───────────────────────────────── */
QProgressBar {
    background-color: #e2e8f0;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    font-size: 0px;
}
QProgressBar::chunk {
    background-color: #1e3a8a;
    border-radius: 4px;
}

/* ── Tool tips ────────────────────────────────────────────── */
QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Message / status bar ─────────────────────────────────── */
QStatusBar {
    background-color: #f8fafc;
    color: #64748b;
    border-top: 1px solid #e2e8f0;
    font-size: 12px;
}

/* ── Separator ────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #e2e8f0;
    background-color: #e2e8f0;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #e2e8f0;
    width: 1px;
    height: 1px;
}

/* ── Login screen specific ────────────────────────────────── */
QFrame#loginCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 8px;
}

QLabel#loginLogo {
    font-size: 28px;
    font-weight: 800;
    color: #1e3a8a;
    background: transparent;
}

QLabel#loginTagline {
    font-size: 14px;
    color: #64748b;
    background: transparent;
}

/* ── Stat card (dashboard widgets) ───────────────────────── */
QFrame#statCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 4px;
}

QLabel#statLabel {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#statValue {
    font-family: "JetBrains Mono", "Fira Code", "Consolas", monospace;
    font-size: 24px;
    font-weight: 700;
    color: #1a1a2e;
    background: transparent;
}

/* ── Mover rows (market movers widget) ───────────────────── */
QFrame#moverRow {
    background-color: #ffffff;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 0px;
}
QFrame#moverRow:hover {
    background-color: #f8fafc;
}
